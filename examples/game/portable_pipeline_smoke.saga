use game

let assets = game.asset_manager()
let texture = unwrap_ok(game.asset_texture(assets, "examples/game/assets/runner.png"))
let sound = unwrap_ok(game.asset_audio(assets, "examples/game/assets/beep.wav"))
let framebuffer = game.framebuffer(64, 48)
let camera = game.camera(0, 0, 1)
let map = game.tilemap(4, 2, 16, 16)
let particles = game.particles()
let animation = game.animation(texture, 16, 16, 4, 8)
let world = game.physics_world(0, 20)
let body = game.physics_body(world, 8, 0, 8, 8, 1, true)
let ground = game.physics_body(world, 0, 32, 64, 16, 1, false)

game.tile_set(map, 0, 0, 0)
game.tile_set(map, 1, 0, 1)
game.tile_set(map, 2, 0, 2)
game.tile_set(map, 3, 0, 3)
game.fb_clear(framebuffer, 8, 12, 18, 255)
game.tile_draw(framebuffer, map, texture, camera, 4)
game.draw_texture(framebuffer, texture, 0, 16)
game.draw_texture_region(framebuffer, texture, 16, 0, 16, 16, 32, 16, 16, 16)
game.draw_animation(framebuffer, animation, 250, 48, 16, 1)
game.fb_pixel(framebuffer, 1, 40, 255, 255, 255, 255)
game.fb_line(framebuffer, 0, 41, 63, 41, 120, 180, 255, 255)
game.fb_circle(framebuffer, 8, 40, 3, 255, 120, 80, 200)
game.particle_emit(particles, 20, 38, 4, -3, 1, 255, 200, 60, 255, 2)
game.particles_update(particles, 0.016, 10)
game.particles_draw(framebuffer, particles, camera)
game.body_force(body, 3, 0)
game.body_impulse(body, 1, 0)
game.physics_step(world, 0.016)

print($"PORTABLE_GAME_OK ${game.fb_width(framebuffer)}x${game.fb_height(framebuffer)} tex=${game.texture_width(texture)}x${game.texture_height(texture)} particles=${game.particle_count(particles)} frame=${game.animation_frame(animation, 250)}")
