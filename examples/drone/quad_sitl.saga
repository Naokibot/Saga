use machine
use drone
let safety = machine.safety_latch()
let flight = drone.flight_manager(safety, 0.2)
drone.health_update(flight, true, true, 0.9, true, true, true)
drone.arm(flight, true)
let att = drone.quaternion_controller(4.0, 4.0, 2.0, 3.0)
let rate = drone.rate_controller(0.5, 0.08, 0.01, 0.4)
let mixer = drone.quad_x_mixer(0.05, 1.0)
let target_q = drone.quaternion_from_rpy(0.10, -0.05, 0.0)
let current_q = drone.quaternion_from_rpy(0.0, 0.0, 0.0)
let rate_sp = drone.quaternion_step(att, target_q, current_q)
let torque = drone.rate_step(rate, rate_sp, [0.0, 0.0, 0.0], 0.01)
print(drone.mix_quad_x(mixer, 0.55, torque[0], torque[1], torque[2]))
