use drone

let trajectory = drone.trajectory3d([0.0, 0.0, -2.0], [12.0, 4.0, -6.0], 4.0, 2.0, 8.0)
let link = drone.link_monitor(0.2)
let allocator = drone.quad_x_allocator(0.0, 1.0)

var i = 0
while i < 20 {
    print(drone.trajectory_step_json(trajectory, 0.02))
    i = i + 1
}

// Observation only. No automatic RTL/LAND/DISARM is triggered by the monitor.
drone.link_observe(link, 10, 8.0)
drone.link_observe(link, 11, 9.0)
drone.link_observe(link, 14, 15.0)
print(drone.link_stats_json(link))

print(drone.allocate(allocator, [0.5, 0.02, -0.01, 0.01]))
print(drone.allocation_report_json(allocator, [0.5, 0.02, -0.01, 0.01]))
