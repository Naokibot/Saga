# Saga SH-3 Standard Core kernel.
# This is the canonical language implementation for SH-3: source validation,
# lexical analysis, parsing/evaluation, static safety preflight, exact-number
# semantics, functions/closures, classes/interfaces/generics, exceptions,
# option/result, enums/records/match, interpolation, and deterministic core I/O.
# It is deliberately written in the restricted self-host subset accepted by
# selfhost/sh3/sh3c.saga so it can execute on the language-neutral bootstrap VM.
use io
use sys

var ktokens: list[any] = slice([0], 0, 0)
var kpos: int = 0
var ksource: text = ""
var klast_error: text = ""
var klast_message: text = ""
var heap_values: list[any] = slice([0], 0, 0)
var heap_mutable: list[any] = slice([0], 0, 0)
var env_names: list[any] = slice([0], 0, 0)
var env_cells: list[any] = slice([0], 0, 0)
var scope_marks: list[any] = slice([0], 0, 0)
var class_names: list[any] = slice([0], 0, 0)
var class_values: list[any] = slice([0], 0, 0)
var enum_names: list[any] = slice([0], 0, 0)
var enum_values: list[any] = slice([0], 0, 0)
var interface_names: list[any] = slice([0], 0, 0)
var output_lines: list[any] = slice([0], 0, 0)
var control_kind: text = "normal"
var control_value: any = 0
var current_class: text = ""
var next_object_id: int = 1
var checking_mode: bool = false
var user_cli_raw: list[any] = slice([0], 0, 0)
var pending_derive_equal: bool = false
var pending_derive_hash: bool = false

fn empty_any() -> list[any] { return slice([0], 0, 0) }
fn empty_text() -> list[text] { return slice([""], 0, 0) }

fn kfail(id: text, message: text) -> any {
    klast_error = id
    klast_message = message
    return ["error", id, message]
}

fn is_error(v: any) -> bool {
    return len(v) >= 1 and v[0] == "error"
}

fn is_digit_char(c: text) -> bool { return find_text("0123456789", c) >= 0 }
fn is_ascii_alpha(c: text) -> bool { return find_text("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c) >= 0 }
fn is_space(c: text) -> bool { return c == " " or c == "\t" or c == "\r" or c == "\n" }

fn tok(kind: text, value: text, line: int, col: int) -> list[any] { return [kind, value, line, col] }
fn tk_kind(i: int) -> text { return ktokens[i][0] }
fn tk_text(i: int) -> text { return ktokens[i][1] }
fn tk_line(i: int) -> int { return ktokens[i][2] }

fn has_bidi(source: text) -> bool {
    # U+202A..U+202E and U+2066..U+2069 UTF-8 prefixes used by bidi controls.
    let e2 = bytechr(226)
    let b80 = bytechr(128)
    var i = 0
    while i + 2 < len(source) {
        if source[i] == e2 and source[i + 1] == b80 {
            let z = byteord(source[i + 2])
            if z >= 170 and z <= 174 { return true }
        }
        if source[i] == e2 and byteord(source[i + 1]) == 129 {
            let z = byteord(source[i + 2])
            if z >= 166 and z <= 169 { return true }
        }
        i = i + 1
    }
    return false
}

fn has_non_nfc_combining(source: text) -> bool {
    # Strict portable source gate: reject the common decomposed combining-mark
    # UTF-8 block U+0300..U+036F. NFC identifiers use precomposed code points.
    var i = 0
    while i + 1 < len(source) {
        let a = byteord(source[i])
        let b = byteord(source[i + 1])
        if a == 204 and b >= 128 { return true }
        if a == 205 and b <= 175 { return true }
        i = i + 1
    }
    return false
}

fn lex_add(kind: text, value: text, line: int, col: int) -> unit {
    ktokens = append(ktokens, tok(kind, value, line, col))
}

fn lex_source(source: text) -> any {
    ktokens = empty_any()
    kpos = 0
    if has_bidi(source) { return kfail("SAGA-L001", "bidi formatting controls are not allowed") }
    if has_non_nfc_combining(source) { return kfail("SAGA-L001", "identifier/source text is not NFC") }
    var i = 0
    var line = 1
    var col = 1
    while i < len(source) {
        let c = source[i]
        if c == "\n" { i = i + 1; line = line + 1; col = 1 } else {
            if c == "\r" { i = i + 1; if i < len(source) and source[i] == "\n" { i = i + 1 }; line = line + 1; col = 1 } else {
                if c == " " or c == "\t" { i = i + 1; col = col + 1 } else {
                    if c == "#" { while i < len(source) and source[i] != "\n" { i = i + 1; col = col + 1 } } else {
                        if c == "/" and i + 1 < len(source) and source[i + 1] == "/" { while i < len(source) and source[i] != "\n" { i = i + 1; col = col + 1 } } else {
                            let bc = byteord(c)
                            if is_ascii_alpha(c) or bc >= 128 {
                                let start = i
                                let scol = col
                                i = i + 1; col = col + 1
                                var scanning_id = true
                                while i < len(source) and scanning_id {
                                    let q = source[i]
                                    let qb = byteord(q)
                                    if is_ascii_alpha(q) or is_digit_char(q) or qb >= 128 { i = i + 1; col = col + 1 } else { scanning_id = false }
                                }
                                lex_add("id", substring(source, start, i), line, scol)
                            } else {
                                if is_digit_char(c) {
                                    let start = i
                                    let scol = col
                                    i = i + 1; col = col + 1
                                    var seen_dot = false
                                    var scanning_num = true
                                    while i < len(source) and scanning_num {
                                        let q = source[i]
                                        if is_digit_char(q) or q == "_" { i = i + 1; col = col + 1 } else {
                                            if q == "." and !seen_dot and !(i + 1 < len(source) and source[i + 1] == ".") { seen_dot = true; i = i + 1; col = col + 1 } else { scanning_num = false }
                                        }
                                    }
                                    if i + 2 < len(source) and source[i] == "f" and source[i + 1] == "3" and source[i + 2] == "2" { i = i + 3; col = col + 3 }
                                    if i + 2 < len(source) and source[i] == "f" and source[i + 1] == "6" and source[i + 2] == "4" { i = i + 3; col = col + 3 }
                                    lex_add("num", substring(source, start, i), line, scol)
                                } else {
                                    if c == "\"" or c == "'" {
                                        let quote = c
                                        let scol = col
                                        i = i + 1; col = col + 1
                                        var value = ""
                                        while i < len(source) and source[i] != quote {
                                            if source[i] == "\\" {
                                                i = i + 1; col = col + 1
                                                if i >= len(source) { return kfail("SAGA-L001", "unterminated escape") }
                                                let e = source[i]
                                                if e == "n" { value = value + "\n" } else { if e == "r" { value = value + "\r" } else { if e == "t" { value = value + "\t" } else { value = value + e } } }
                                                i = i + 1; col = col + 1
                                            } else {
                                                value = value + source[i]
                                                i = i + 1; col = col + 1
                                            }
                                        }
                                        if i >= len(source) { return kfail("SAGA-L001", "unterminated string") }
                                        i = i + 1; col = col + 1
                                        lex_add("str", value, line, scol)
                                    } else {
                                        if c == "$" and i + 1 < len(source) and source[i + 1] == "\"" {
                                            let scol = col
                                            i = i + 2; col = col + 2
                                            var value = ""
                                            while i < len(source) and source[i] != "\"" {
                                                if source[i] == "\\" and i + 1 < len(source) { value = value + source[i] + source[i + 1]; i = i + 2; col = col + 2 } else { value = value + source[i]; i = i + 1; col = col + 1 }
                                            }
                                            if i >= len(source) { return kfail("SAGA-L001", "unterminated interpolation") }
                                            i = i + 1; col = col + 1
                                            lex_add("istr", value, line, scol)
                                        } else {
                                            var two = ""
                                            if i + 1 < len(source) { two = substring(source, i, i + 2) }
                                            if two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "->" or two == ".." or two == "**" {
                                                lex_add("sym", two, line, col); i = i + 2; col = col + 2
                                            } else {
                                                lex_add("sym", c, line, col); i = i + 1; col = col + 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    lex_add("eof", "<eof>", line, col)
    return ["ok"]
}

fn apply_edition_directive()->any {
    if len(ktokens)>=3 and ktokens[0][0]=="id" and ktokens[0][1]=="edition" {
        let ed=ktokens[1][1]
        if ktokens[1][0]!="num" or !(ed=="2027" or ed=="1.0" or ed=="1") { return kfail("SAGA-P001","unsupported language edition") }
        var start=2
        if start<len(ktokens) and ktokens[start][1]==";" { start=start+1 }
        ktokens=slice(ktokens,start,len(ktokens))
    }
    return ["ok"]
}

# ---------- arbitrary-precision signed decimal integer helpers ----------
fn bi_strip(a: text) -> text {
    var neg = false
    var s = a
    if len(s) > 0 and s[0] == "-" { neg = true; s = substring(s, 1, len(s)) }
    var i = 0
    while i + 1 < len(s) and s[i] == "0" { i = i + 1 }
    s = substring(s, i, len(s))
    if s == "" { s = "0" }
    if neg and s != "0" { return "-" + s }
    return s
}
fn bi_neg(a: text) -> text { a = bi_strip(a); if a == "0" { return "0" }; if a[0] == "-" { return substring(a,1,len(a)) }; return "-" + a }
fn bi_abs(a: text) -> text { a = bi_strip(a); if len(a)>0 and a[0]=="-" { return substring(a,1,len(a)) }; return a }
fn bi_sign(a: text) -> int { a=bi_strip(a); if a=="0" { return 0 }; if a[0]=="-" { return -1 }; return 1 }
fn bi_cmp_abs(a: text,b: text)->int { a=bi_abs(a);b=bi_abs(b);if len(a)<len(b){return -1};if len(a)>len(b){return 1};if a<b{return -1};if a>b{return 1};return 0 }
fn digit_value(c:text)->int { return find_text("0123456789",c) }
fn digit_text(n:int)->text { return "0123456789"[n] }
fn bi_add_abs(a:text,b:text)->text {
    a=bi_abs(a);b=bi_abs(b);var i=len(a)-1;var j=len(b)-1;var carry=0;var r=""
    while i>=0 or j>=0 or carry>0 {
        var x=0;var y=0;if i>=0{x=digit_value(a[i])};if j>=0{y=digit_value(b[j])};let z=x+y+carry;var q=z;carry=0;while q>=10{q=q-10;carry=carry+1};r=digit_text(q)+r;i=i-1;j=j-1
    }
    return bi_strip(r)
}
fn bi_sub_abs(a:text,b:text)->text {
    # requires |a| >= |b|
    a=bi_abs(a);b=bi_abs(b);var i=len(a)-1;var j=len(b)-1;var borrow=0;var r=""
    while i>=0 { var x=digit_value(a[i])-borrow;var y=0;if j>=0{y=digit_value(b[j])};borrow=0;if x<y{x=x+10;borrow=1};r=digit_text(x-y)+r;i=i-1;j=j-1 }
    return bi_strip(r)
}
fn bi_add(a:text,b:text)->text { let sa=bi_sign(a);let sb=bi_sign(b);if sa==0{return bi_strip(b)};if sb==0{return bi_strip(a)};if sa==sb{let r=bi_add_abs(a,b);if sa<0{return "-"+r};return r};let c=bi_cmp_abs(a,b);if c==0{return "0"};if c>0{let r=bi_sub_abs(a,b);if sa<0{return "-"+r};return r};let r=bi_sub_abs(b,a);if sb<0{return "-"+r};return r }
fn bi_sub(a:text,b:text)->text { return bi_add(a,bi_neg(b)) }
fn bi_mul(a:text,b:text)->text {
    let sa=bi_sign(a);let sb=bi_sign(b);if sa==0 or sb==0{return "0"};a=bi_abs(a);b=bi_abs(b);var result="0";var j=len(b)-1;var zeros=""
    while j>=0 { let d=digit_value(b[j]);var part="0";var k=0;while k<d{part=bi_add_abs(part,a);k=k+1};part=part+zeros;result=bi_add_abs(result,part);zeros=zeros+"0";j=j-1 }
    if sa!=sb{return "-"+result};return result
}
fn bi_divmod_abs(a:text,b:text)->list[any] {
    a=bi_abs(a);b=bi_abs(b);if b=="0"{return ["0",a]};var q="";var rem="0";var i=0
    while i<len(a){rem=bi_strip(rem+a[i]);var d=0;while bi_cmp_abs(rem,b)>=0{rem=bi_sub_abs(rem,b);d=d+1};q=q+digit_text(d);i=i+1}
    return [bi_strip(q),bi_strip(rem)]
}
fn bi_div(a:text,b:text)->text { let sa=bi_sign(a);let sb=bi_sign(b);let dm=bi_divmod_abs(a,b);var q=dm[0];if sa!=0 and sb!=0 and sa!=sb and q!="0"{q="-"+q};return q }
fn bi_mod(a:text,b:text)->text { let dm=bi_divmod_abs(a,b);var r=dm[1];if bi_sign(a)<0 and r!="0"{r="-"+r};return r }
fn bi_gcd(a:text,b:text)->text { a=bi_abs(a);b=bi_abs(b);while b!="0"{let dm=bi_divmod_abs(a,b);a=b;b=dm[1]};return a }
fn bi_cmp(a:text,b:text)->int { let sa=bi_sign(a);let sb=bi_sign(b);if sa<sb{return -1};if sa>sb{return 1};if sa==0{return 0};let c=bi_cmp_abs(a,b);if sa<0{return -c};return c }

fn v_num(n:text,d:text,flavor:text)->list[any] { if d=="0"{return ["error","SAGA-R101","division by zero"]};if bi_sign(d)<0{n=bi_neg(n);d=bi_neg(d)};let g=bi_gcd(n,d);if g!="0"{n=bi_div(n,g);d=bi_div(d,g)};return ["num",bi_strip(n),bi_strip(d),flavor] }
fn v_bool(x:bool)->list[any] { if x{return ["bool",1]};return ["bool",0] }
fn v_text(x:text)->list[any] { return ["text",x] }
fn v_unit()->list[any] { return ["unit"] }
fn v_list(x:list[any])->list[any] { return ["list",x] }
fn v_option(some:bool,x:any)->list[any] { if some{return ["option",1,x]};return ["option",0,v_unit()] }
fn v_result(okay:bool,x:any)->list[any] { if okay{return ["result",1,x]};return ["result",0,x] }
fn v_error(kind:text,message:text)->list[any] { return ["errorvalue",kind,message] }
fn v_tag(v:any)->text { return v[0] }
fn num_is_int(v:any)->bool { return v_tag(v)=="num" and v[2]=="1" and v[3]=="exact" }
fn value_truth(v:any)->bool { if v_tag(v)=="bool"{return v[1]!=0};return false }
fn num_add(a:any,b:any)->any { if a[3]!="exact" or b[3]!="exact" { if a[3]=="exact" or b[3]=="exact"{return kfail("SAGA-T170","exact and float arithmetic requires explicit conversion")};return v_num(bi_add(bi_mul(a[1],b[2]),bi_mul(b[1],a[2])),bi_mul(a[2],b[2]),a[3]) };return v_num(bi_add(bi_mul(a[1],b[2]),bi_mul(b[1],a[2])),bi_mul(a[2],b[2]),"exact") }
fn num_sub(a:any,b:any)->any { let nb=["num",bi_neg(b[1]),b[2],b[3]];return num_add(a,nb) }
fn num_mul(a:any,b:any)->any { if a[3]!="exact" or b[3]!="exact" { if a[3]=="exact" or b[3]=="exact"{return kfail("SAGA-T170","exact and float arithmetic requires explicit conversion")};return v_num(bi_mul(a[1],b[1]),bi_mul(a[2],b[2]),a[3]) };return v_num(bi_mul(a[1],b[1]),bi_mul(a[2],b[2]),"exact") }
fn num_div(a:any,b:any)->any { return v_num(bi_mul(a[1],b[2]),bi_mul(a[2],b[1]),a[3]) }
fn num_cmp(a:any,b:any)->int { return bi_cmp(bi_mul(a[1],b[2]),bi_mul(b[1],a[2])) }

fn parse_number(raw:text)->any {
    var flavor="exact";if ends_with(raw,"f32"){flavor="float32";raw=substring(raw,0,len(raw)-3)};if ends_with(raw,"f64"){flavor="float64";raw=substring(raw,0,len(raw)-3)}
    let dot=find_text(raw,".");if dot<0{return v_num(replace(raw,"_",""),"1",flavor)};let a=replace(substring(raw,0,dot),"_","");let b=replace(substring(raw,dot+1,len(raw)),"_","");var den="1";var i=0;while i<len(b){den=den+"0";i=i+1};return v_num(a+b,den,flavor)
}

fn pow10_text(n:int)->text { var r="1";var i=0;while i<n{r=r+"0";i=i+1};return r }
fn num_decimal_text(v:any)->text {
    var n=v[1];let d=v[2];var sign="";if bi_sign(n)<0{sign="-";n=bi_abs(n)};let dm=bi_divmod_abs(n,d);var whole=dm[0];var rem=dm[1];if rem=="0"{return sign+whole};var frac="";var count=0;while rem!="0" and count<128{rem=bi_mul(rem,"10");let q=bi_divmod_abs(rem,d);frac=frac+q[0];rem=q[1];count=count+1};return sign+whole+"."+frac
}
fn num_floor(v:any)->any { let n=v[1];let d=v[2];let q=bi_div(n,d);let r=bi_mod(n,d);if bi_sign(n)<0 and r!="0"{return v_num(bi_sub(q,"1"),"1","exact")};return v_num(q,"1","exact") }
fn num_ceil(v:any)->any { let n=v[1];let d=v[2];let q=bi_div(n,d);let r=bi_mod(n,d);if bi_sign(n)>0 and r!="0"{return v_num(bi_add(q,"1"),"1","exact")};return v_num(q,"1","exact") }
fn num_round_places(v:any,places:int)->any { let scale=pow10_text(places);let scaled=bi_mul(v[1],scale);let sign=bi_sign(scaled);let dm=bi_divmod_abs(scaled,v[2]);var q=dm[0];let twice=bi_mul(dm[1],"2");if bi_cmp_abs(twice,v[2])>=0{q=bi_add_abs(q,"1")};if sign<0 and q!="0"{q="-"+q};return v_num(q,scale,"decimal") }

fn value_text(v:any)->text {
    let tag=v_tag(v)
    if tag=="text"{return v[1]}
    if tag=="bool"{if v[1]!=0{return "true"};return "false"}
    if tag=="unit"{return "unit"}
    if tag=="num"{if v[3]=="decimal"{return num_decimal_text(v)};if v[2]=="1"{return v[1]};return v[1]+"/"+v[2]}
    if tag=="option"{if v[1]==0{return "none"};return "some("+value_text(v[2])+")"}
    if tag=="result"{if v[1]!=0{return "ok("+value_text(v[2])+")"};return "err("+value_text(v[2])+")"}
    if tag=="errorvalue"{return v[2]}
    if tag=="enum"{return v[1]+"."+v[2]}
    if tag=="record"{var r=v[1]+"(";var i=0;while i<len(v[3]){if i>0{r=r+", "};r=r+value_text(v[3][i]);i=i+1};return r+")"}
    if tag=="object"{var r=v[1]+"(";var shown=0;var i=0;while i<len(v[2]){if !v[4][i]{if shown>0{r=r+", "};r=r+v[2][i]+"="+value_text(cell_get(v[3][i]));shown=shown+1};i=i+1};return r+")"}
    if tag=="set"{var r="set{";var i=0;while i<len(v[1]){if i>0{r=r+", "};r=r+value_text(v[1][i]);i=i+1};return r+"}"}
    if tag=="map"{var r="{";var i=0;while i+1<len(v[1]){if i>0{r=r+", "};r=r+value_text(v[1][i])+": "+value_text(v[1][i+1]);i=i+2};return r+"}"}
    if tag=="list"{var r="[";var i=0;while i<len(v[1]){if i>0{r=r+", "};r=r+value_text(v[1][i]);i=i+1};return r+"]"}
    return "<"+tag+">"
}

# ---------- environment / cells ----------
fn new_cell(value:any,mutable:bool)->int { let id=len(heap_values);heap_values=append(heap_values,value);heap_mutable=append(heap_mutable,mutable);return id }
fn cell_get(id:int)->any { return heap_values[id] }
fn cell_set(id:int,value:any)->unit { heap_values=set_at(heap_values,id,value) }
fn env_find(name:text)->int { var i=len(env_names)-1;while i>=0{if env_names[i]==name{return env_cells[i]};i=i-1};return -1 }
fn env_declare(name:text,value:any,mutable:bool)->int { let id=new_cell(value,mutable);env_names=append(env_names,name);env_cells=append(env_cells,id);return id }
fn push_scope()->unit { scope_marks=append(scope_marks,len(env_names)) }
fn pop_scope()->unit { let n=scope_marks[len(scope_marks)-1];scope_marks=slice(scope_marks,0,len(scope_marks)-1);env_names=slice(env_names,0,n);env_cells=slice(env_cells,0,n) }
fn assign_name(name:text,value:any)->any { let id=env_find(name);if id<0{return kfail("SAGA-T102","unknown name "+name)};if !heap_mutable[id]{return kfail("SAGA-T101","cannot assign to immutable binding")};cell_set(id,value);return value }
fn get_name(name:text)->any { let id=env_find(name);if id<0{return kfail("SAGA-T102","unknown name "+name)};return cell_get(id) }

# ---------- token parser helpers ----------
fn ppeek(value:text)->bool { let k=tk_kind(kpos);if k=="str" or k=="num" or k=="istr"{return false};return tk_text(kpos)==value }
fn ptake(value:text)->bool { if ppeek(value){kpos=kpos+1;return true};return false }
fn pexpect(value:text)->any { if !ptake(value){return kfail("SAGA-P001","expected "+value+" got "+tk_text(kpos))};return v_unit() }
fn pid()->text { if tk_kind(kpos)!="id"{kfail("SAGA-P001","expected identifier");return ""};let r=tk_text(kpos);kpos=kpos+1;return r }
fn skip_type()->text { var r="";var sq=0;while tk_text(kpos)!="<eof>"{let t=tk_text(kpos);if sq==0 and (t=="=" or t=="," or t==")" or t=="{" or t=="}" or t==";" or t=="where"){return r};if t=="["{sq=sq+1};if t=="]"{sq=sq-1};r=r+t;kpos=kpos+1};return r }
fn matching_brace(open:int)->int { var d=0;var i=open;while i<len(ktokens){let t=tk_text(i);if tk_kind(i)=="sym" and t=="{"{d=d+1};if tk_kind(i)=="sym" and t=="}"{d=d-1;if d==0{return i}};i=i+1};return -1 }

# ---------- declarations ----------
fn find_class(name:text)->any { var i=0;while i<len(class_names){if class_names[i]==name{return class_values[i]};i=i+1};return ["none"] }
fn store_class(name:text,value:any)->unit { let i=list_find_text(class_names,name);if i>=0{class_values=set_at(class_values,i,value)}else{class_names=append(class_names,name);class_values=append(class_values,value)} }
fn find_enum(name:text)->any { var i=0;while i<len(enum_names){if enum_names[i]==name{return enum_values[i]};i=i+1};return ["none"] }
fn list_find_text(xs:list[any],value:text)->int { var i=0;while i<len(xs){if xs[i]==value{return i};i=i+1};return -1 }

fn capture_function(name:text,params:list[any],start:int,end:int)->any { return ["fn",name,params,start,end,env_names,env_cells] }

fn declare_function()->any {
    pexpect("fn");let name=pid();if ptake("["){var d=1;while d>0{if ptake("["){d=d+1}else{if ptake("]"){d=d-1}else{kpos=kpos+1}}}}
    pexpect("(");var params=empty_any();if !ppeek(")"){let p=pid();params=append(params,p);if ptake(":"){skip_type()};while ptake(","){p=pid();params=append(params,p);if ptake(":"){skip_type()}}};pexpect(")");if ptake("->"){skip_type()};if ptake("where"){while !ppeek("{") and !ppeek("="){kpos=kpos+1}}
    var start=0;var end=0
    if ptake("="){
        start=kpos
        var par=0
        var br=0
        var scanning=true
        while scanning and !ppeek("<eof>") {
            let t=tk_text(kpos)
            if par==0 and br==0 and (ppeek(";") or ppeek("}")) { scanning=false } else {
                if par==0 and br==0 and kpos>start and (t=="let" or t=="var" or t=="print" or t=="if" or t=="while" or t=="for" or t=="return" or t=="fn" or t=="class" or t=="interface" or t=="try" or t=="match" or t=="enum" or t=="record" or t=="override" or t=="abstract") { scanning=false } else {
                    if t=="("{par=par+1};if t==")"{par=par-1};if t=="["{br=br+1};if t=="]"{br=br-1};kpos=kpos+1
                }
            }
        }
        end=kpos
        ptake(";")
    }else{start=kpos;end=matching_brace(kpos);kpos=end+1}
    let placeholder=new_cell(v_unit(),false);env_names=append(env_names,name);env_cells=append(env_cells,placeholder);let f=capture_function(name,params,start,end);cell_set(placeholder,f);return f
}

fn declare_interface()->any { pexpect("interface");let name=pid();if ptake("["){var d=1;while d>0{if ptake("["){d=d+1}else{if ptake("]"){d=d-1}else{kpos=kpos+1}}}};if ppeek("{"){let e=matching_brace(kpos);kpos=e+1};interface_names=append(interface_names,name);return v_unit() }

fn parse_field_decl(names:list[any],privs:list[any])->list[any] {
    var private=false;if ptake("private"){private=true};if ppeek("let") or ppeek("var"){kpos=kpos+1};let n=pid();if ptake(":"){skip_type()};names=append(names,n);privs=append(privs,private);return [names,privs]
}

fn declare_class(is_abstract:bool)->any {
    if is_abstract{pexpect("abstract")};pexpect("class");let name=pid();if ptake("["){var gd=1;while gd>0{if ptake("["){gd=gd+1}else{if ptake("]"){gd=gd-1}else{kpos=kpos+1}}}}
    var fields=empty_any();var privs=empty_any();if ptake("("){if !ppeek(")"){let z=parse_field_decl(fields,privs);fields=z[0];privs=z[1];while ptake(","){z=parse_field_decl(fields,privs);fields=z[0];privs=z[1]}};pexpect(")")}
    var base="";if ptake("extends"){base=pid();if ptake("["){var d=1;while d>0{if ptake("["){d=d+1}else{if ptake("]"){d=d-1}else{kpos=kpos+1}}}}};if ptake("implements"){while !ppeek("{"){kpos=kpos+1}}
    pexpect("{");var method_names=empty_any();var methods=empty_any();while !ppeek("}"){if ptake("type"){pid();if ptake("="){skip_type()};ptake(";")}else{if ptake("abstract"){if ppeek("fn"){pexpect("fn");let mn=pid();while !ppeek(";") and !ppeek("}"){kpos=kpos+1};ptake(";");method_names=append(method_names,mn);methods=append(methods,["abstract"])}else{kpos=kpos+1}}else{if ptake("override"){};if ppeek("fn"){let f=declare_function();var ps=empty_any();ps=append(ps,"self");var pi=0;while pi<len(f[2]){ps=append(ps,f[2][pi]);pi=pi+1};f=set_at(f,2,ps);method_names=append(method_names,f[1]);methods=append(methods,f)}else{let z=parse_field_decl(fields,privs);fields=z[0];privs=z[1];ptake(";")}}}};pexpect("}")
    let c=["class",name,base,fields,privs,method_names,methods,is_abstract,pending_derive_equal,pending_derive_hash];pending_derive_equal=false;pending_derive_hash=false;store_class(name,c);let old=env_find(name);if old<0{env_declare(name,c,false)}else{cell_set(old,c)};return c
}

fn declare_enum()->any { pexpect("enum");let name=pid();pexpect("{");var variants=empty_any();if !ppeek("}"){variants=append(variants,pid());while ptake(","){if !ppeek("}"){variants=append(variants,pid())}}};pexpect("}");let e=["enumtype",name,variants];enum_names=append(enum_names,name);enum_values=append(enum_values,e);env_declare(name,e,false);return e }
fn declare_record()->any { pexpect("record");let name=pid();pexpect("(");var fields=empty_any();if !ppeek(")"){fields=append(fields,pid());if ptake(":"){skip_type()};while ptake(","){fields=append(fields,pid());if ptake(":"){skip_type()}}};pexpect(")");let r=["recordtype",name,fields];env_declare(name,r,false);return r }

# ---------- expression evaluation ----------
fn eval_expr()->any { return eval_or() }
fn eval_or()->any { var a=eval_and();while ptake("or"){let b=eval_and();a=v_bool(value_truth(a) or value_truth(b))};return a }
fn eval_and()->any { var a=eval_equality();while ptake("and"){let b=eval_equality();a=v_bool(value_truth(a) and value_truth(b))};return a }
fn value_equal(a:any,b:any)->bool { if v_tag(a)!=v_tag(b){return false};let t=v_tag(a);if t=="num"{return num_cmp(a,b)==0};if t=="text"{return a[1]==b[1]};if t=="bool"{return a[1]==b[1]};if t=="enum"{return a[1]==b[1] and a[2]==b[2]};if t=="record"{if a[1]!=b[1] or len(a[3])!=len(b[3]){return false};var i=0;while i<len(a[3]){if !value_equal(a[3][i],b[3][i]){return false};i=i+1};return true};if t=="object"{if a[6]==b[6]{return true};if len(a)>5 and a[5]{if a[1]!=b[1]{return false};var i=0;while i<len(a[3]){if !value_equal(cell_get(a[3][i]),cell_get(b[3][i])){return false};i=i+1};return true};return false};if t=="set"{if len(a[1])!=len(b[1]){return false};var i=0;while i<len(a[1]){var found=false;var j=0;while j<len(b[1]){if value_equal(a[1][i],b[1][j]){found=true};j=j+1};if !found{return false};i=i+1};return true};if t=="map"{if len(a[1])!=len(b[1]){return false};var i=0;while i<len(a[1]){if !value_equal(a[1][i],b[1][i]){return false};i=i+1};return true};return value_text(a)==value_text(b) }
fn eval_equality()->any { var a=eval_compare();while ppeek("==") or ppeek("!="){let op=tk_text(kpos);kpos=kpos+1;let b=eval_compare();let eq=value_equal(a,b);if op=="!="{eq=!eq};a=v_bool(eq)};return a }
fn eval_compare()->any { var a=eval_term();while ppeek("<") or ppeek("<=") or ppeek(">") or ppeek(">="){let op=tk_text(kpos);kpos=kpos+1;let b=eval_term();var c=0;if v_tag(a)=="num" and v_tag(b)=="num"{c=num_cmp(a,b)}else{if value_text(a)<value_text(b){c=-1}else{if value_text(a)>value_text(b){c=1}}};if op=="<"{a=v_bool(c<0)};if op=="<="{a=v_bool(c<=0)};if op==">"{a=v_bool(c>0)};if op==">="{a=v_bool(c>=0)}};return a }
fn eval_term()->any { var a=eval_factor();while ppeek("+") or ppeek("-"){let op=tk_text(kpos);kpos=kpos+1;let b=eval_factor();if op=="+"{if v_tag(a)=="text" and v_tag(b)=="text"{a=v_text(a[1]+b[1])}else{a=num_add(a,b)}}else{a=num_sub(a,b)}};return a }
fn eval_factor()->any { var a=eval_power();while ppeek("*") or ppeek("/") or ppeek("%"){let op=tk_text(kpos);kpos=kpos+1;let b=eval_power();if op=="*"{a=num_mul(a,b)};if op=="/"{a=num_div(a,b)};if op=="%"{a=v_num(bi_mod(a[1],b[1]),"1","exact")}};return a }
fn eval_power()->any { var a=eval_unary();if ptake("**"){let b=eval_unary();if !num_is_int(b){return kfail("SAGA-T103","power exponent must be int")};var n=int(b[1]);var neg=n<0;if neg{n=-n};var r=v_num("1","1",a[3]);var i=0;while i<n{r=num_mul(r,a);i=i+1};if neg{r=num_div(v_num("1","1",a[3]),r)};a=r};return a }
fn eval_unary()->any { if ptake("!") or ptake("not"){return v_bool(!value_truth(eval_unary()))};if ptake("-"){let x=eval_unary();if v_tag(x)!="num"{return kfail("SAGA-T103","unary minus requires number")};return ["num",bi_neg(x[1]),x[2],x[3]]};if ptake("move"){let name=pid();let id=env_find(name);if id<0{return kfail("SAGA-T102","unknown name")};let v=cell_get(id);cell_set(id,["moved"]);return v};if ptake("await"){let x=eval_unary();if v_tag(x)=="future"{return x[1]};return x};return eval_postfix() }

fn is_builtin_name(name:text)->bool {
    return name=="print" or name=="len" or name=="text" or name=="int" or name=="int8" or name=="int16" or name=="int32" or name=="int64" or name=="uint8" or name=="uint16" or name=="uint32" or name=="uint64" or name=="float32" or name=="float64" or name=="none" or name=="some" or name=="ok" or name=="err" or name=="is_some" or name=="is_none" or name=="is_ok" or name=="is_err" or name=="unwrap" or name=="unwrap_ok" or name=="unwrap_or" or name=="map_of" or name=="map_get" or name=="map_put" or name=="map_remove" or name=="map_keys" or name=="map_values" or name=="map_contains" or name=="set_of" or name=="set_add" or name=="set_remove" or name=="set_contains" or name=="set_union" or name=="set_intersection" or name=="append" or name=="prepend" or name=="get" or name=="contains" or name=="slice" or name=="reverse" or name=="sort" or name=="unique" or name=="transform" or name=="filter" or name=="reduce" or name=="find" or name=="any" or name=="all" or name=="sum" or name=="mean" or name=="split" or name=="join" or name=="trim" or name=="upper" or name=="lower" or name=="replace" or name=="starts_with" or name=="ends_with" or name=="substring" or name=="find_text" or name=="repeat" or name=="set_at" or name=="sqrt" or name=="round" or name=="floor" or name=="ceil" or name=="assert" or name=="precision" or name=="ratio" or name=="decimal" or name=="abs" or name=="min" or name=="max"
}

fn invoke_builtin(name:text,args:list[any])->any {
    var ai=0;while ai<len(args){if is_error(args[ai]){return args[ai]};ai=ai+1}
    if name=="io.read_text"{return v_text(io.read_text(args[0][1]))}
    if name=="io.write_text"{io.write_text(args[0][1],args[1][1]);return v_unit()}
    if name=="sys.args"{var out=empty_any();var i=0;while i<len(user_cli_raw){out=append(out,v_text(user_cli_raw[i]));i=i+1};return v_list(out)}
    if name=="app.host"{if host_available("app"){return v_text(host_call("app.host",[]))};return v_text("sh3")}
    if name=="app.capability"{if !host_available("app"){return v_bool(false)};return v_bool(host_call("app.capability",[args[0][1]]))}
    if name=="app.capabilities"{if !host_available("app"){return v_list(empty_any())};let z=host_call("app.capabilities",[]);var xs=empty_any();var ai=0;while ai<len(z){xs=append(xs,v_text(z[ai]));ai=ai+1};return v_list(xs)}
    if name=="app.operation_supported"{if !host_available("app"){return v_bool(false)};return v_bool(host_call("app.operation_supported",[args[0][1]]))}
    if name=="app.operations"{if !host_available("app"){return v_list(empty_any())};let z=host_call("app.operations",[]);var xs=empty_any();var ai=0;while ai<len(z){xs=append(xs,v_text(z[ai]));ai=ai+1};return v_list(xs)}
    if name=="app.invoke"{if !host_available("app"){return v_result(false,v_text("universal app host unavailable"))};let z=host_call("app.invoke",[args[0][1],args[1][1]]);if z[0]{return v_result(true,v_text(z[1]))};return v_result(false,v_text(z[1]))}
    if name=="app.invoke_async"{if !host_available("app"){return v_result(false,v_text("universal app host unavailable"))};let z=host_call("app.invoke_async",[args[0][1],args[1][1],args[2][1]]);if z[0]{return v_result(true,v_num(text(z[1]),"1","exact"))};return v_result(false,v_text(z[1]))}
    if name=="app.cancel"{if !host_available("app"){return v_result(false,v_text("universal app host unavailable"))};let z=host_call("app.cancel",[value_text(args[0])]);if z{return v_result(true,v_unit())};return v_result(false,v_text("app async handle not found"))}
    if name=="app.on"{if !host_available("app"){return v_result(false,v_text("universal app host unavailable"))};let z=host_call("app.on",[args[0][1],args[1][1]]);if z[0]{return v_result(true,v_num(text(z[1]),"1","exact"))};return v_result(false,v_text(z[1]))}
    if name=="app.off"{if !host_available("app"){return v_result(false,v_text("universal app host unavailable"))};let z=host_call("app.off",[value_text(args[0])]);if z{return v_result(true,v_unit())};return v_result(false,v_text("app event handle not found"))}
    if name=="web.browser_available"{return v_bool(host_available("dom"))}
    if name=="web.capability"{return v_bool(host_available(args[0][1]))}
    if name=="web.exists" or name=="web.query_exists"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.exists";if name=="web.query_exists"{op="dom.query_exists"};let z=host_call(op,[args[0][1]]);return v_result(true,v_bool(z))}
    if name=="web.query_count"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};let z=host_call("dom.query_count",[args[0][1]]);return v_result(true,v_num(text(z),"1","exact"))}
    if name=="web.title"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};return v_result(true,v_text(host_call("dom.title",[])))}
    if name=="web.set_title"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};host_call("dom.set_title",[args[0][1]]);return v_result(true,v_unit())}
    if name=="web.set_text" or name=="web.set_html" or name=="web.set_value" or name=="web.append_html" or name=="web.prepend_html" or name=="web.add_class" or name=="web.remove_class" or name=="web.on_click"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.set_text";if name=="web.set_html"{op="dom.set_html"};if name=="web.set_value"{op="dom.set_value"};if name=="web.append_html"{op="dom.append_html"};if name=="web.prepend_html"{op="dom.prepend_html"};if name=="web.add_class"{op="dom.add_class"};if name=="web.remove_class"{op="dom.remove_class"};if name=="web.on_click"{op="dom.on_click"};host_call(op,[args[0][1],args[1][1]]);return v_result(true,v_unit())}
    if name=="web.text" or name=="web.html" or name=="web.value"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.text";if name=="web.html"{op="dom.html"};if name=="web.value"{op="dom.value"};return v_result(true,v_text(host_call(op,[args[0][1]])))}
    if name=="web.create"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};host_call("dom.create",[args[0][1],args[1][1],args[2][1]]);return v_result(true,v_unit())}
    if name=="web.clear" or name=="web.remove" or name=="web.focus" or name=="web.blur" or name=="web.click" or name=="web.scroll_into_view"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.clear";if name=="web.remove"{op="dom.remove"};if name=="web.focus"{op="dom.focus"};if name=="web.blur"{op="dom.blur"};if name=="web.click"{op="dom.click"};if name=="web.scroll_into_view"{op="dom.scroll_into_view"};host_call(op,[args[0][1]]);return v_result(true,v_unit())}
    if name=="web.set_attr" or name=="web.set_style" or name=="web.on_event" or name=="web.dispatch_event"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.set_attr";if name=="web.set_style"{op="dom.set_style"};if name=="web.on_event"{op="dom.on_event"};if name=="web.dispatch_event"{op="dom.dispatch_event"};host_call(op,[args[0][1],args[1][1],args[2][1]]);return v_result(true,v_unit())}
    if name=="web.remove_attr"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};host_call("dom.remove_attr",[args[0][1],args[1][1]]);return v_result(true,v_unit())}
    if name=="web.attr"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};let z=host_call("dom.attr",[args[0][1],args[1][1]]);if z[0]{return v_result(true,v_option(true,v_text(z[1])))};return v_result(true,v_option(false,v_unit()))}
    if name=="web.style"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};return v_result(true,v_text(host_call("dom.style",[args[0][1],args[1][1]])))}
    if name=="web.toggle_class" or name=="web.has_class"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.toggle_class";if name=="web.has_class"{op="dom.has_class"};return v_result(true,v_bool(host_call(op,[args[0][1],args[1][1]])))}
    if name=="web.set_checked" or name=="web.set_disabled"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.set_checked";if name=="web.set_disabled"{op="dom.set_disabled"};host_call(op,[args[0][1],value_text(args[1])]);return v_result(true,v_unit())}
    if name=="web.checked" or name=="web.disabled"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};var op="dom.checked";if name=="web.disabled"{op="dom.disabled"};return v_result(true,v_bool(host_call(op,[args[0][1]])))}
    if name=="web.set_selected_index"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};host_call("dom.set_selected_index",[args[0][1],value_text(args[1])]);return v_result(true,v_unit())}
    if name=="web.selected_index"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};return v_result(true,v_num(text(host_call("dom.selected_index",[args[0][1]])),"1","exact"))}
    if name=="web.rect"{if !host_available("dom"){return v_result(false,v_text("browser DOM host unavailable"))};let z=host_call("dom.rect",[args[0][1]]);var xs=empty_any();var i=0;while i<len(z){xs=append(xs,v_text(z[i]));i=i+1};return v_result(true,v_list(xs))}
    if name=="web.storage_set" or name=="web.session_set"{let cap="storage";var op="storage.set";if name=="web.session_set"{cap="session";op="storage.session_set"};if !host_available(cap){return v_result(false,v_text("browser storage unavailable"))};host_call(op,[args[0][1],args[1][1]]);return v_result(true,v_unit())}
    if name=="web.storage_get" or name=="web.session_get" or name=="web.cookie_get"{var cap="storage";var op="storage.get";if name=="web.session_get"{cap="session";op="storage.session_get"};if name=="web.cookie_get"{cap="cookie";op="cookie.get"};if !host_available(cap){return v_result(false,v_text("browser storage unavailable"))};let z=host_call(op,[args[0][1]]);if z[0]{return v_result(true,v_option(true,v_text(z[1])))};return v_result(true,v_option(false,v_unit()))}
    if name=="web.storage_remove" or name=="web.session_remove" or name=="web.cookie_remove"{var cap="storage";var op="storage.remove";if name=="web.session_remove"{cap="session";op="storage.session_remove"};if name=="web.cookie_remove"{cap="cookie";op="cookie.remove"};if !host_available(cap){return v_result(false,v_text("browser storage unavailable"))};host_call(op,[args[0][1]]);return v_result(true,v_unit())}
    if name=="web.storage_clear" or name=="web.session_clear"{var cap="storage";var op="storage.clear";if name=="web.session_clear"{cap="session";op="storage.session_clear"};if !host_available(cap){return v_result(false,v_text("browser storage unavailable"))};host_call(op,[]);return v_result(true,v_unit())}
