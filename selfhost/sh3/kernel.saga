    if name=="repeat"{var out=empty_any();var i=0;while i<int(args[1][1]){out=append(out,args[0]);i=i+1};return v_list(out)}
    if name=="set_at"{let xs=args[0][1];let n=int(args[1][1]);if n<0 or n>=len(xs){return kfail("SAGA-R101","index out of range")};return v_list(set_at(xs,n,args[2]))}
    return ["notbuiltin"]
}

fn class_all_fields(c:any)->list[any] { var r=empty_any();if c[2]!=""{let b=find_class(c[2]);if b[0]!="none"{let bf=class_all_fields(b);var j=0;while j<len(bf){r=append(r,bf[j]);j=j+1}}};var i=0;while i<len(c[3]){r=append(r,c[3][i]);i=i+1};return r }
fn class_all_priv(c:any)->list[any] { var r=empty_any();if c[2]!=""{let b=find_class(c[2]);if b[0]!="none"{let bf=class_all_priv(b);var j=0;while j<len(bf){r=append(r,bf[j]);j=j+1}}};var i=0;while i<len(c[4]){r=append(r,c[4][i]);i=i+1};return r }
fn class_find_method(c:any,name:text)->any { var i=0;while i<len(c[5]){if c[5][i]==name{return c[6][i]};i=i+1};if c[2]!=""{let b=find_class(c[2]);if b[0]!="none"{return class_find_method(b,name)}};return ["none"] }

fn invoke_function(f:any,args:list[any])->any {
    let tag=v_tag(f)
    if tag=="native"{return invoke_builtin(f[1],args)}
    if tag=="class"{if f[7]{return kfail("SAGA-T111","cannot instantiate abstract class")};let names=class_all_fields(f);let priv=class_all_priv(f);var cells=empty_any();var i=0;while i<len(names){var v=v_unit();if i<len(args){v=args[i]};cells=append(cells,new_cell(v,false));i=i+1};let oid=next_object_id;next_object_id=next_object_id+1;var deq=false;var dh=false;if len(f)>8{deq=f[8]};if len(f)>9{dh=f[9]};return ["object",f[1],names,cells,priv,deq,oid,dh]}
    if tag=="recordtype"{return ["record",f[1],f[2],args]}
    if tag=="bound"{var aa=empty_any();aa=append(aa,f[1]);var j=0;while j<len(args){aa=append(aa,args[j]);j=j+1};return invoke_function(f[2],aa)}
    if tag!="fn"{return kfail("SAGA-T103","value is not callable")}
    let saved_names=env_names;let saved_cells=env_cells;let saved_pos=kpos;env_names=f[5];env_cells=f[6];push_scope();var i=0;while i<len(f[2]){var a=v_unit();if i<len(args){a=args[i]};env_declare(f[2][i],a,true);i=i+1};let start=f[3];let end=f[4];kpos=start;control_kind="normal";control_value=v_unit();var result=v_unit();if tk_text(start)=="{"{kpos=start+1;result=exec_until(end)}else{result=eval_expr()};if control_kind=="return"{result=control_value};pop_scope();env_names=saved_names;env_cells=saved_cells;kpos=saved_pos;control_kind="normal";return result
}

fn member_get(obj:any,name:text)->any {
    let tag=v_tag(obj)
    if tag=="errorvalue"{if name=="message"{return v_text(obj[2])};if name=="kind"{return v_text(obj[1])}}
    if tag=="module"{return ["native",obj[1]+"."+name]}
    if tag=="enumtype"{let variants=obj[2];var i=0;while i<len(variants){if variants[i]==name{return ["enum",obj[1],name]};i=i+1};return kfail("SAGA-R123","unknown enum variant")}
    if tag=="object"{var i=0;while i<len(obj[2]){if obj[2][i]==name{if obj[4][i] and current_class!=obj[1]{return kfail("SAGA-T107","private member access")};return cell_get(obj[3][i])};i=i+1};let c=find_class(obj[1]);let m=class_find_method(c,name);if m[0]!="none"{return ["bound",obj,m]};return kfail("SAGA-R123","unknown member")}
    return kfail("SAGA-R123","unknown member")
}

fn eval_call(callee:any)->any { pexpect("(");var args=empty_any();var first_error=v_unit();if !ppeek(")"){let a=eval_expr();if is_error(a){first_error=a};args=append(args,a);while ptake(","){a=eval_expr();if is_error(a) and !is_error(first_error){first_error=a};args=append(args,a)}};pexpect(")");if is_error(callee){return callee};if is_error(first_error){return first_error};return invoke_function(callee,args) }

fn eval_interpolation(raw:text)->any {
    var out="";var i=0
    while i<len(raw){if i+1<len(raw) and raw[i]=="$" and raw[i+1]=="{"{let start=i+2;var j=start;var depth=1;while j<len(raw) and depth>0{if raw[j]=="{"{depth=depth+1};if raw[j]=="}"{depth=depth-1};if depth>0{j=j+1}};let sub=substring(raw,start,j);let save_tokens=ktokens;let save_pos=kpos;lex_source(sub);kpos=0;let v=eval_expr();ktokens=save_tokens;kpos=save_pos;out=out+value_text(v);i=j+1}else{out=out+raw[i];i=i+1}}
    return v_text(out)
}

fn eval_primary()->any {
    if tk_kind(kpos)=="num"{let v=parse_number(tk_text(kpos));kpos=kpos+1;return v}
    if tk_kind(kpos)=="str"{let v=v_text(tk_text(kpos));kpos=kpos+1;return v}
    if tk_kind(kpos)=="istr"{let r=eval_interpolation(tk_text(kpos));kpos=kpos+1;return r}
    if ptake("true"){return v_bool(true)};if ptake("false"){return v_bool(false)}
    if ptake("["){var xs=empty_any();if !ppeek("]"){xs=append(xs,eval_expr());while ptake(","){xs=append(xs,eval_expr())}};pexpect("]");return v_list(xs)}
    if ptake("("){let v=eval_expr();pexpect(")");return v}
    let name=pid();let cid=env_find(name);if cid>=0{return cell_get(cid)};if is_builtin_name(name){return ["native",name]};return get_name(name)
}

fn eval_postfix()->any {
    var v=eval_primary()
    var keep=true
    while keep {
        if ppeek("("){v=eval_call(v)}else{if ptake("["){let idx=eval_expr();pexpect("]");if v_tag(v)=="list"{let n=int(idx[1]);if n<0 or n>=len(v[1]){return kfail("SAGA-R101","index out of range")};v=v[1][n]}else{if v_tag(v)=="text"{let n=int(idx[1]);if n<0 or n>=len(v[1]){return kfail("SAGA-R101","index out of range")};v=v_text(v[1][n])}else{return kfail("SAGA-T103","indexing requires list or text")}}}else{if ptake("."){v=member_get(v,pid())}else{if ptake("?"){if v_tag(v)=="result"{if v[1]==0{set_control("return",v);return v};v=v[2]}else{if v_tag(v)=="option"{if v[1]==0{set_control("return",v);return v};v=v[2]}else{return kfail("SAGA-T103","? requires result or option")}}}else{keep=false}}}}
    }
    return v
}

# ---------- statements / control ----------
fn set_control(kind:text,value:any)->unit { control_kind=kind;control_value=value }
fn skip_decl_type()->unit { if ptake(":"){skip_type()} }
fn exec_var()->any { let mutable=ptake("var");if !mutable{pexpect("let")};let name=pid();if ptake(":"){skip_type()};pexpect("=");let v=eval_expr();env_declare(name,v,mutable);ptake(";");return v_unit() }

fn exec_if()->any { pexpect("if");let cond=eval_expr();if v_tag(cond)!="bool"{return kfail("SAGA-T104","if condition must be bool")};let open=kpos;pexpect("{");let end=matching_brace(open);if value_truth(cond){push_scope();let r=exec_until(end);pop_scope();kpos=end+1;if ptake("else"){if ppeek("if"){let save=kpos;exec_if();kpos=skip_statement_from(save)}else{let o=kpos;let e=matching_brace(o);kpos=e+1}};return r}else{kpos=end+1;if ptake("else"){if ppeek("if"){return exec_if()}else{let o=kpos;pexpect("{");let e=matching_brace(o);push_scope();let r=exec_until(e);pop_scope();kpos=e+1;return r}}};return v_unit() }
fn skip_statement_from(start:int)->int { let save=kpos;kpos=start;if ppeek("if"){pexpect("if");while !ppeek("{"){kpos=kpos+1};let e=matching_brace(kpos);kpos=e+1;if ptake("else"){if ppeek("if"){kpos=skip_statement_from(kpos)}else{let x=matching_brace(kpos);kpos=x+1}}};let r=kpos;kpos=save;return r }

fn exec_while()->any { pexpect("while");let cond_start=kpos;while !ppeek("{"){# parse once only to find block
        kpos=kpos+1
    };let open=kpos;let end=matching_brace(open);var done=false;var last=v_unit();while !done{kpos=cond_start;let cond=eval_expr();if v_tag(cond)!="bool"{return kfail("SAGA-T103","while condition must be bool")};if !value_truth(cond){done=true}else{kpos=open+1;push_scope();last=exec_until(end);pop_scope();if control_kind=="return" or control_kind=="throw"{done=true}else{if control_kind=="break"{control_kind="normal";done=true}else{if control_kind=="continue"{control_kind="normal"}}}}};kpos=end+1;return last }

fn exec_for()->any { pexpect("for");let name=pid();pexpect("in");let start=eval_expr();pexpect("..");let finish=eval_expr();let open=kpos;pexpect("{");let end=matching_brace(open);var n=int(start[1]);let z=int(finish[1]);while n<=z{push_scope();env_declare(name,v_num(text(n),"1","exact"),false);kpos=open+1;exec_until(end);pop_scope();if control_kind=="return" or control_kind=="throw"{kpos=end+1;return control_value};if control_kind=="break"{control_kind="normal";n=z+1}else{if control_kind=="continue"{control_kind="normal"};n=n+1}};kpos=end+1;return v_unit() }

fn exec_try()->any { pexpect("try");let open=kpos;pexpect("{");let end=matching_brace(open);push_scope();let r=exec_until(end);pop_scope();kpos=end+1;var thrown=control_kind=="throw";let thrown_value=control_value;if thrown{control_kind="normal"};if ptake("catch"){let name=pid();let co=kpos;pexpect("{");let ce=matching_brace(co);if thrown{push_scope();env_declare(name,thrown_value,false);r=exec_until(ce);pop_scope()};kpos=ce+1;thrown=false};if ptake("finally"){let fo=kpos;pexpect("{");let fe=matching_brace(fo);push_scope();let fr=exec_until(fe);pop_scope();if control_kind!="normal"{r=fr};kpos=fe+1};if thrown{set_control("throw",thrown_value)};return r }

fn exec_match()->any { pexpect("match");let target=eval_expr();let open=kpos;pexpect("{");let end=matching_brace(open);var matched=false;var r=v_unit();while kpos<end{if ptake("case"){let cv=eval_expr();let bo=kpos;pexpect("{");let be=matching_brace(bo);if !matched and value_equal(target,cv){push_scope();r=exec_until(be);pop_scope();matched=true}else{kpos=be};kpos=be+1}else{if ptake("default"){let bo=kpos;pexpect("{");let be=matching_brace(bo);if !matched{push_scope();r=exec_until(be);pop_scope();matched=true}else{kpos=be};kpos=be+1}else{kpos=kpos+1}}};kpos=end+1;return r }

fn exec_using()->any { pexpect("using");let name=pid();pexpect("=");let value=eval_expr();let open=kpos;pexpect("{");let end=matching_brace(open);push_scope();env_declare(name,value,false);let r=exec_until(end);let closev=member_get(value,"close");if !is_error(closev){invoke_function(closev,empty_any())};pop_scope();kpos=end+1;return r }

fn exec_statement()->any {
    if ptake(";"){return v_unit()}
    if ptake("@"){let an=pid();if an=="derive" and ptake("("){while !ppeek(")"){if tk_kind(kpos)=="str"{let d=tk_text(kpos);if d=="Equal"{pending_derive_equal=true};if d=="Hash"{pending_derive_hash=true};kpos=kpos+1}else{kpos=kpos+1};ptake(",")};pexpect(")")};return v_unit()}
    if ptake("use"){let mod=pid();env_declare(mod,["module",mod],false);ptake(";");return v_unit()}
    if ptake("resource"){if ppeek("class"){declare_class(false);return v_unit()};return kfail("SAGA-P001","resource must modify class")}
    if ptake("async"){if ppeek("fn"){declare_function();return v_unit()};return kfail("SAGA-P001","async must modify fn")}
    if ptake("comptime"){if ppeek("fn"){declare_function();return v_unit()};return kfail("SAGA-P001","comptime must modify fn")}
    if ppeek("using"){return exec_using()}
    if ppeek("let") or ppeek("var"){return exec_var()}
    if ppeek("fn"){declare_function();return v_unit()}
    if ppeek("interface"){return declare_interface()}
    if ppeek("abstract") and tk_text(kpos+1)=="class"{return declare_class(true)}
    if ppeek("class"){return declare_class(false)}
    if ppeek("enum"){return declare_enum()}
    if ppeek("record"){return declare_record()}
    if ppeek("if"){return exec_if()}
    if ppeek("while"){return exec_while()}
    if ppeek("for"){return exec_for()}
    if ppeek("try"){return exec_try()}
    if ppeek("match"){return exec_match()}
    if ptake("return"){var v=v_unit();if !ppeek(";") and !ppeek("}"){v=eval_expr()};ptake(";");set_control("return",v);return v}
    if ptake("throw"){let v=eval_expr();if v_tag(v)=="text"{v=v_error("Thrown",v[1])};ptake(";");set_control("throw",v);return v}
    if ptake("break"){ptake(";");set_control("break",v_unit());return v_unit()}
    if ptake("continue"){ptake(";");set_control("continue",v_unit());return v_unit()}
    if tk_kind(kpos)=="id" and tk_text(kpos+1)=="="{let name=pid();pexpect("=");let v=eval_expr();ptake(";");return assign_name(name,v)}
    let v=eval_expr();ptake(";");return v
}

fn exec_until(end:int)->any { var last=v_unit();while kpos<end and control_kind=="normal"{last=exec_statement();if is_error(last){return last}};return last }

# ---------- static preflight ----------
fn static_preflight()->any {
    # This pass enforces the safety properties whose result must be known before
    # execution. Runtime expression/type checks handle the remaining structural
    # type rules on the same canonical parser.
    var names=empty_any();var muts=empty_any();var types=empty_any();var moved=empty_any();var private_specs=empty_any();var abstract_classes=empty_any();var base_methods=empty_any();var base_method_classes=empty_any();var annotations=empty_any();var fn_names=empty_any();var fn_returns=empty_any();var i=0
    while i<len(ktokens)-1 {
        let t=tk_text(i)
        if t=="@" and i+1<len(ktokens) and tk_kind(i+1)=="id" { let an=tk_text(i+1); if list_find_text(annotations,an)>=0{return kfail("SAGA-T108","duplicate annotation "+an)};annotations=append(annotations,an) } else { if t!="@" and (i==0 or tk_text(i-1)!="@") { annotations=empty_any() } }
        if t=="fn" and i+1<len(ktokens) and tk_kind(i+1)=="id" { let fnn=tk_text(i+1);var fj=i+2;while fj<len(ktokens) and tk_text(fj)!="->" and tk_text(fj)!="{" and tk_text(fj)!="="{fj=fj+1};var fr="";if fj<len(ktokens) and tk_text(fj)=="->"{fj=fj+1;while fj<len(ktokens) and tk_text(fj)!="{" and tk_text(fj)!="=" and tk_text(fj)!="where"{fr=fr+tk_text(fj);fj=fj+1}};fn_names=append(fn_names,fnn);fn_returns=append(fn_returns,fr) }
        if t=="abstract" and i+2<len(ktokens) and tk_text(i+1)=="class" and tk_kind(i+2)=="id" { abstract_classes=append(abstract_classes,tk_text(i+2)) }
        if t=="class" and i+1<len(ktokens) and tk_kind(i+1)=="id" {
            let cn=tk_text(i+1)
            var cj=i+2
            var base=""
            var seek=i+2
            while seek<len(ktokens) and tk_text(seek)!="{" { if tk_text(seek)=="extends" and seek+1<len(ktokens){base=tk_text(seek+1)};seek=seek+1 }
            if seek<len(ktokens) { let ce=matching_brace(seek);var mj=seek+1;while mj<ce{if tk_text(mj)=="fn" and mj+1<ce{let mn=tk_text(mj+1);if base!="" and list_find_text(base_methods,base+"."+mn)>=0 and (mj==0 or tk_text(mj-1)!="override"){return kfail("SAGA-T110","overriding method requires override")};base_methods=append(base_methods,cn+"."+mn)};mj=mj+1} }
            var cj=i+2
            if tk_text(cj)=="["{var gd=1;cj=cj+1;while gd>0 and cj<len(ktokens){if tk_text(cj)=="["{gd=gd+1};if tk_text(cj)=="]"{gd=gd-1};cj=cj+1}}
            if cj<len(ktokens) and tk_text(cj)=="(" { cj=cj+1;while cj<len(ktokens) and tk_text(cj)!=")" { if tk_text(cj)=="private" and (tk_text(cj+1)=="let" or tk_text(cj+1)=="var") and tk_kind(cj+2)=="id" { private_specs=append(private_specs,cn+"."+tk_text(cj+2)) }; cj=cj+1 } }
        }
        if t=="let" or t=="var"{if tk_kind(i+1)=="id"{let n=tk_text(i+1);names=append(names,n);muts=append(muts,t=="var");var ty="";var j=i+2;if tk_text(j)==":"{j=j+1;while j<len(ktokens) and tk_text(j)!="="{ty=ty+tk_text(j);j=j+1}}else{if j+2<len(ktokens) and tk_text(j)=="=" and tk_kind(j+1)=="id" and tk_text(j+2)=="("{ty=tk_text(j+1)}};types=append(types,ty);if j+2<len(ktokens) and tk_text(j)=="=" and tk_text(j+1)=="move" and tk_kind(j+2)=="id"{moved=append(moved,tk_text(j+2))};if j+2<len(ktokens) and tk_text(j)=="=" and tk_kind(j+1)=="id" and tk_text(j+2)=="(" { let ctor=tk_text(j+1);if list_find_text(abstract_classes,ctor)>=0{return kfail("SAGA-T111","cannot construct abstract class")};if find_text(ty,"[text]")>=0 and tk_kind(j+3)=="num"{return kfail("SAGA-T103","generic interface binding is invariant")} }}}
        if tk_kind(i)=="id" and tk_text(i+1)=="=" and (i==0 or (tk_text(i-1)!="let" and tk_text(i-1)!="var")){let p=list_find_text(names,t);if p>=0 and !muts[p]{return kfail("SAGA-T101","cannot assign to immutable binding "+t)}}
        if tk_kind(i)=="id" and list_find_text(moved,t)>=0{let prev="";if i>0{prev=tk_text(i-1)};if prev!="move"{return kfail("SAGA-T180","use of moved resource "+t)}}
        if tk_kind(i)=="id" and i+2<len(ktokens) and tk_text(i+1)=="." and tk_kind(i+2)=="id" { let vp=list_find_text(names,t); if vp>=0 and types[vp]!="" { var base=types[vp];let gp=find_text(base,"[");if gp>=0{base=substring(base,0,gp)}; if list_find_text(private_specs,base+"."+tk_text(i+2))>=0{return kfail("SAGA-T107","private member access")}} }
        if t=="filter" and i+2<len(ktokens) and tk_text(i+1)=="(" and tk_kind(i+2)=="id" { let fp=list_find_text(fn_names,tk_text(i+2));if fp>=0 and fn_returns[fp]!="bool"{return kfail("SAGA-T103","filter predicate must return bool")} }
        if t=="map_of" and i+2<len(ktokens) and tk_text(i+1)=="(" and tk_text(i+2)=="["{return kfail("SAGA-T103","map key is not hashable")}
        if t=="ffi" and i+1<len(ktokens) and tk_text(i+1)=="."{return kfail("SAGA-T178","FFI requires unsafe block")}
        if tk_kind(i)=="num" and i+2<len(ktokens) and (tk_text(i+1)=="+" or tk_text(i+1)=="-" or tk_text(i+1)=="*" or tk_text(i+1)=="/") and tk_kind(i+2)=="num"{let lf=ends_with(t,"f64") or ends_with(t,"f32");let rf=ends_with(tk_text(i+2),"f64") or ends_with(tk_text(i+2),"f32");if lf!=rf{return kfail("SAGA-T170","exact/float arithmetic requires explicit conversion")}}
        i=i+1
    }
    # Generic invariance: reject typed assignment G[A] <- G[B] when spellings differ.
    i=0
    while i<len(names){var j=i+1;while j<len(names){if types[i]!="" and types[j]!="" and find_text(types[i],"[")>=0 and find_text(types[j],"[")>=0{let bi=substring(types[i],0,find_text(types[i],"["));let bj=substring(types[j],0,find_text(types[j],"["));if bi==bj and types[i]!=types[j]{# Only reject when later initializer references earlier name; conservative scan.
                    return kfail("SAGA-T103","generic types are invariant")
                }};j=j+1};i=i+1}
    return ["ok"]
}

fn reset_kernel()->unit { ktokens=empty_any();kpos=0;klast_error="";klast_message="";heap_values=empty_any();heap_mutable=empty_any();env_names=empty_any();env_cells=empty_any();scope_marks=empty_any();class_names=empty_any();class_values=empty_any();enum_names=empty_any();enum_values=empty_any();interface_names=empty_any();output_lines=empty_any();control_kind="normal";control_value=v_unit();current_class="";next_object_id=1;checking_mode=false;pending_derive_equal=false;pending_derive_hash=false }

fn run_source(source:text,execute:bool)->any {
    reset_kernel();checking_mode=!execute;ksource=source;let lr=lex_source(source);if is_error(lr){return lr};let er=apply_edition_directive();if is_error(er){return er};let sr=static_preflight();if is_error(sr){return sr};kpos=0;control_kind="normal";let r=exec_until(len(ktokens)-1);if is_error(r){return r};if control_kind=="throw"{return kfail("SAGA-R101",value_text(control_value))};return ["ok",r]
}



# ---------- canonical SH3 token-image lowering ----------
fn hex_digit(n:int)->text { let h="0123456789abcdef";return substring(h,n,n+1) }
fn hex_encode_text(x:text)->text { var out="";var i=0;while i<len(x){let b=byteord(substring(x,i,i+1));out=out+hex_digit(b/16)+hex_digit(b%16);i=i+1};if out==""{return "-"};return out }
fn hex_nibble(ch:text)->int { let h="0123456789abcdef";let p=find_text(h,ch);if p<0{return 0};return p }
fn hex_decode_text(x:text)->text { if x=="-"{return ""};var out="";var i=0;while i+1<len(x){let b=hex_nibble(substring(x,i,i+1))*16+hex_nibble(substring(x,i+1,i+2));out=out+bytechr(b);i=i+2};return out }

fn encode_token_image()->text {
    var out="SH3IMG1\n";var i=0
    while i<len(ktokens){let t=ktokens[i];out=out+hex_encode_text(t[0])+" "+hex_encode_text(t[1])+" "+text(t[2])+" "+text(t[3])+"\n";i=i+1}
    return out
}

fn decode_token_image(image:text)->any {
    if !starts_with(image,"SH3IMG1\n"){return kfail("SAGA-P001","invalid SH3 token image")}
    ktokens=empty_any();var pos=8
    while pos<len(image){let tail=substring(image,pos,len(image));let nl=find_text(tail,"\n");var line="";var next=len(image);if nl<0{line=tail}else{line=substring(image,pos,pos+nl);next=pos+nl+1};if line!=""{let a=find_text(line," ");let b=find_text(substring(line,a+1,len(line))," ")+a+1;let c=find_text(substring(line,b+1,len(line))," ")+b+1;if a<0 or b<=a or c<=b{return kfail("SAGA-P001","malformed SH3 token image")};let k=hex_decode_text(substring(line,0,a));let v=hex_decode_text(substring(line,a+1,b));let ln=int(substring(line,b+1,c));let col=int(substring(line,c+1,len(line)));ktokens=append(ktokens,tok(k,v,ln,col))};if nl<0{pos=len(image)}else{pos=next}}
    return ["ok"]
}

fn prepare_source_image(source:text)->any { reset_kernel();ksource=source;let lr=lex_source(source);if is_error(lr){return lr};let er=apply_edition_directive();if is_error(er){return er};let sr=static_preflight();if is_error(sr){return sr};return ["ok",encode_token_image()] }
fn run_token_image(image:text,execute:bool)->any { reset_kernel();checking_mode=!execute;let d=decode_token_image(image);if is_error(d){return d};let sr=static_preflight();if is_error(sr){return sr};kpos=0;control_kind="normal";let r=exec_until(len(ktokens)-1);if is_error(r){return r};if control_kind=="throw"{return kfail("SAGA-R101",value_text(control_value))};return ["ok",r] }

# ---------- canonical source loader ----------
var loader_seen=empty_any()
var loader_active=empty_any()
var loader_root=""

fn path_dir(path:text)->text {
    var i=len(path)-1
    while i>=0 {
        let ch=substring(path,i,i+1)
        if ch=="/" or ch=="\\" { if i==0{return "/"};return substring(path,0,i) }
        i=i-1
    }
    return "."
}

fn path_join(base:text,rel:text)->text {
    if starts_with(rel,"/"){return rel}
    if len(rel)>=2 and substring(rel,1,2)==":"{return rel}
    if base=="." or base==""{return rel}
    if ends_with(base,"/") or ends_with(base,"\\"){return base+rel}
    return base+"/"+rel
}

fn path_clean(path:text)->text {
    # Loader policy is implemented in Saga.  The host seed only reads the final
    # path.  Normalize slash-separated '.'/'..' components deterministically.
    let absolute=starts_with(path,"/")
    var parts=empty_any();var start=0;var i=0
    while i<=len(path){
        if i==len(path) or substring(path,i,i+1)=="/" or substring(path,i,i+1)=="\\"{
            let part=substring(path,start,i)
            if part!="" and part!="."{
                if part==".."{if len(parts)>0{parts=slice(parts,0,len(parts)-1)}else{if !absolute{parts=append(parts,"..")}}}
                else{parts=append(parts,part)}
            }
            start=i+1
        }
        i=i+1
    }
    var out="";i=0
    if absolute{out="/"}
    while i<len(parts){if i>0{out=out+"/"};out=out+parts[i];i=i+1}
    if out==""{return "."}
    return out
}

fn path_is_within(root:text,path:text)->bool {
    let r=path_clean(root);let p=path_clean(path)
    if r=="."{return !starts_with(p,"../") and p!=".."}
    return p==r or starts_with(p,r+"/")
}

fn loader_seen_has(path:text)->bool { var i=0;while i<len(loader_seen){if loader_seen[i]==path{return true};i=i+1};return false }
fn loader_active_has(path:text)->bool { var i=0;while i<len(loader_active){if loader_active[i]==path{return true};i=i+1};return false }

fn ltrim_source(line:text)->text { var i=0;while i<len(line) and (substring(line,i,i+1)==" " or substring(line,i,i+1)=="\t"){i=i+1};return substring(line,i,len(line)) }

fn load_source_tree(path:text)->text {
    let clean=path_clean(path)
    if !path_is_within(loader_root,clean){print("SAGA-P001: source unit escapes project root: "+clean);sys.exit(66)}
    if loader_active_has(clean){print("SAGA-P001: source-unit dependency cycle: "+clean);sys.exit(3)}
    if loader_seen_has(clean){return ""}
    loader_active=append(loader_active,clean)
    let source=io.read_text(clean)
    let base=path_dir(clean)
    var out="";var pos=0
    while pos<len(source){
        let tail=substring(source,pos,len(source));let off=find_text(tail,"\n");var line="";var next=len(source)
        if off<0{line=tail}else{line=substring(source,pos,pos+off);next=pos+off+1}
        let t=ltrim_source(line)
        if starts_with(t,"use \""){
            let rest=substring(t,5,len(t));let q=find_text(rest,"\"")
            if q<0{print("SAGA-P001: malformed source-unit use");sys.exit(3)}
            let rel=substring(rest,0,q)
            if !ends_with(rel,".saga"){print("SAGA-P001: source unit must end in .saga");sys.exit(3)}
            let dep=path_clean(path_join(base,rel));out=out+load_source_tree(dep)+"\n"
        }else{out=out+line+"\n"}
        if off<0{pos=len(source)}else{pos=next}
    }
    loader_active=slice(loader_active,0,len(loader_active)-1);loader_seen=append(loader_seen,clean)
    return out
}

fn load_entry_source(path:text)->text {
    loader_seen=empty_any();loader_active=empty_any();loader_root=path_dir(path_clean(path));return load_source_tree(path_clean(path))
}

fn main_cli()->int {
    let args=sys.args();if len(args)>=1 and (args[0]=="--version" or args[0]=="version"){print("Saga SH-3 0.28.0");return 0};if len(args)>=1 and args[0]=="info"{print("implementation=saga-sh3");print("version=0.28.0");print("language=Saga");print("standard_core=true");print("edition_2027_preview=true");print("all_runtime_source_self_hosted=true");print("bootstrap_machine=language-neutral-c11");return 0};if len(args)<2{print("usage: saga <run|check|compile|run-image|check-image|info|version> input [output]");return 64};let command=args[0];let path=args[1];user_cli_raw=slice(args,2,len(args))
    if command=="compile"{if len(args)<3{print("SAGA-P001: compile requires output path");return 64};let source=load_entry_source(path);let c=prepare_source_image(source);if is_error(c){print(c[1]+": "+c[2]);return 4};io.write_text(args[2],c[1]);return 0}
    if command=="run-image" or command=="check-image"{let image=io.read_text(path);let r=run_token_image(image,command=="run-image");if is_error(r){print(r[1]+": "+r[2]);return 4};if command=="check-image"{print("OK")};return 0}
    let source=load_entry_source(path);let r=run_source(source,command=="run");if is_error(r){print(r[1]+": "+r[2]);return 4};if command=="check"{print("OK")};return 0
}

let exit_code=main_cli()
sys.exit(exit_code)
